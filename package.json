{
  "name": "daniilzinovyev-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Personal website for Daniil Zinovyev",
  "scripts": {
    "dev": "vite",
    "build": "npm run resume && tsc --noEmit && vite build",
    "build:site": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "resume": "node resume/render.mjs",
    "infra:synth": "npm --prefix infra run synth",
    "infra:diff": "npm --prefix infra run diff",
    "deploy": "npm run build && npm --prefix infra run deploy"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "puppeteer": "^23.6.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
